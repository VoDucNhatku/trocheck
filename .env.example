# Copy to .env and fill in. Never commit .env.

# API
# Omit DATABASE_URL to use the absolute <repo>/data/db/rener.sqlite default.
# For a separate local development DB, use an absolute path (forward slashes on Windows):
# DATABASE_URL=sqlite:///F:/TMG Final Project/rener-vn-latest/data/db/web-api-dev.sqlite
SECRET_KEY=change-me
ALLOWED_ORIGINS=http://localhost:3000,chrome-extension://<extension-id>
# Google OAuth (API server only; optional). Register this exact callback with Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Worker / LLM (worker only)
GEMINI_API_KEY=
GEMINI_MODEL_ID=
LLM_MAX_ATTEMPTS=3
LLM_TIMEOUT_SECONDS=45

# Business rules (defaults from docs/02-data/05-gop-trung-va-thong-ke.md)
MARKET_MIN_N=10
MARKET_WINDOW_DAYS=30
MARKET_NEAR_MEDIAN_PERCENT=10

# Show demo data (spec/fixtures + generated DEMO posts) instead of real data. Never mixed.
DEMO_MODE=false
# Password of the demo accounts created by `make seed` (admin, reviewer, collector, researcher, renter)
SEED_PASSWORD=

# Web
# Copy these WEB values to apps/web/.env.local (Next does not read this root .env).
# Server-only; do not put secrets in NEXT_PUBLIC_* variables.
API_BASE_URL=http://127.0.0.1:8000/api/v1
API_TIMEOUT_MS=8000
