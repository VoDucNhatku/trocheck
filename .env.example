# Copy to .env and fill in. Never commit .env.

# API
# Omit DATABASE_URL to use the absolute <repo>/data/db/rener.sqlite default.
# For a separate local development DB, use an absolute path (forward slashes on Windows):
# DATABASE_URL=sqlite:///F:/TMG Final Project/rener-vn-latest/data/db/web-api-dev.sqlite
# Neon PostgreSQL: set DATABASE_URL in Render Dashboard after deploying PostgreSQL support.
# Accepts postgres://, postgresql://, postgresql+psycopg://; preserve Neon's sslmode.
# Never put real connection strings in chat or git.
# First admin: requires both variables; existing passwords and roles stay unchanged.
ADMIN_USERNAME=
ADMIN_PASSWORD=
SECRET_KEY=change-me
ALLOWED_ORIGINS=http://localhost:3000,chrome-extension://<extension-id>
# Google OAuth (API server only; optional). Register this exact callback with Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Worker / LLM (worker only)
GEMINI_API_KEY=
GEMINI_MODEL_ID=
LLM_MAX_ATTEMPTS=3
LLM_TIMEOUT_SECONDS=45
# Daily limits (Vietnam time); 0 turns a limit off. The two INGEST limits apply to accounts without the collector role.
LLM_DAILY_CALL_LIMIT=2000
INGEST_DAILY_LIMIT=200
INGEST_IMAGE_DAILY_LIMIT=600

# Business rules (defaults from docs/02-data/05-gop-trung-va-thong-ke.md)
MARKET_MIN_N=10
MARKET_WINDOW_DAYS=30
MARKET_NEAR_MEDIAN_PERCENT=10

# Show demo data (spec/fixtures + generated DEMO posts) instead of real data. Never mixed.
DEMO_MODE=false
# Password of the demo accounts created by `make seed` (admin, reviewer, collector, researcher, renter)
# Only for new accounts; repeated seeding preserves existing accounts and demo posts.
SEED_PASSWORD=

# Web
# Copy these WEB values to apps/web/.env.local (Next does not read this root .env).
# Server-only; do not put secrets in NEXT_PUBLIC_* variables.
API_BASE_URL=http://127.0.0.1:8000/api/v1
API_TIMEOUT_MS=8000

# Bot duyệt chạy song song: mặc định tắt; thiếu khóa Gemini thì không chạy.
REVIEW_BOT_ENABLED=false
# Để rỗng thì dùng GEMINI_MODEL_ID.
REVIEW_BOT_MODEL_ID=
# Lượt bot mỗi ngày Việt Nam; 0 = không có hạn mức riêng, vẫn tính vào hạn mức chung.
REVIEW_BOT_DAILY_CALL_LIMIT=500

# Optional publication permission, requiring REVIEW_BOT_ENABLED too (ADR-0009).
REVIEW_BOT_AUTO_APPROVE=false
# Vietnam day; 0 blocks all auto-approvals. Undo does not refund this cap.
REVIEW_BOT_AUTO_APPROVE_DAILY_LIMIT=200
