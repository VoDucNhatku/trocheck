{
  "manifest_version": 3,
  "name": "TrọCheck Collector",
  "version": "0.3.1",
  "description": "Lưu bài từ nhóm và tìm kiếm bài viết Facebook, che số điện thoại, tự động gửi về kho sau khi kết nối. Có thể tắt trong Cài đặt.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://*.fbcdn.net/*",
    "https://api.typesafe.ai/*",
    "https://ollama.com/*",
    "https://trocheck-api.onrender.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "TrọCheck Collector",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "privacy.js",
        "collector.js",
        "content-script.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://trocheck.vercel.app/*", "http://localhost:3000/*", "http://127.0.0.1:3000/*"],
      "js": ["web-connect.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon-128.png"
  }
}
